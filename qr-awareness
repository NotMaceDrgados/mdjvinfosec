<style>
  /* ---------- Theme tokens ---------- */
  :root {
    color-scheme: dark;
    --bg: #060a10;
    --ink: #eaf0f6;
    --body: #c5d0dc;
    --muted: #8d9bad;
    --line: rgba(120, 200, 255, 0.14);
    --card: rgba(255, 255, 255, 0.035);
    --cyan: #3fe0ff;
    --blue: #4d7cff;
    --violet: #a46bff;
    --red: #ff4d5e;
    --red-bg: rgba(255, 77, 94, 0.1);
    --red-line: rgba(255, 77, 94, 0.42);
    --green: #3ddc97;
    --green-bg: rgba(61, 220, 151, 0.09);
    --green-line: rgba(61, 220, 151, 0.4);
    --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    --mono: ui-monospace, "SF Mono", SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace;
    --ease: cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font: 17px/1.6 var(--sans);
    overflow-x: hidden;
  }
  /* Faint cyber grid */
  body::before {
    content: "";
    position: fixed; inset: 0; z-index: 0; pointer-events: none;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 44px 44px;
    -webkit-mask-image: radial-gradient(ellipse 90% 60% at 50% 0%, #000 0%, transparent 80%);
            mask-image: radial-gradient(ellipse 90% 60% at 50% 0%, #000 0%, transparent 80%);
    opacity: 0.55;
  }
  /* CRT scanlines */
  body::after {
    content: "";
    position: fixed; inset: 0; z-index: 40; pointer-events: none;
    background: repeating-linear-gradient(0deg, rgba(255,255,255,0.016) 0 1px, transparent 1px 3px);
  }

  a { color: inherit; }
  :focus-visible { outline: 2px solid var(--cyan); outline-offset: 3px; border-radius: 6px; }
  strong { color: var(--ink); }

  /* ---------- Chrome: progress bar + section dots ---------- */
  .progress {
    position: fixed; top: 0; left: 0; z-index: 60;
    width: 100%; height: 3px;
    background: linear-gradient(90deg, var(--cyan), var(--blue), var(--violet));
    box-shadow: 0 0 12px rgba(63, 224, 255, 0.6);
    transform: scaleX(0); transform-origin: 0 50%;
  }
  .dots {
    position: fixed; right: 22px; top: 50%; z-index: 50;
    transform: translateY(-50%);
    display: none; flex-direction: column; gap: 14px;
  }
  .dots a {
    display: block; width: 10px; height: 10px; border-radius: 50%;
    border: 1px solid var(--muted); transition: all 0.3s var(--ease);
  }
  .dots a[aria-current="true"] {
    background: var(--cyan); border-color: var(--cyan);
    box-shadow: 0 0 10px var(--cyan); transform: scale(1.3);
  }
  @media (min-width: 960px) { .dots { display: flex; } }

  /* ---------- Layout ---------- */
  .panel {
    position: relative; z-index: 1;
    min-height: 100vh; min-height: 100svh;
    display: flex; align-items: center;
    padding: 88px 16px;
  }
  .wrap { width: 100%; max-width: 820px; margin: 0 auto; }

  .kicker {
    display: flex; align-items: center; gap: 12px;
    font: 600 13px/1 var(--mono); letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--cyan); margin-bottom: 20px;
  }
  .kicker::after { content: ""; flex: 1; height: 1px; background: linear-gradient(90deg, var(--line), transparent); }
  .kicker.red { color: var(--red); }
  .kicker.green { color: var(--green); }

  h1, h2 { margin: 0; letter-spacing: -0.025em; }
  h2 { font-size: clamp(30px, 6vw, 50px); line-height: 1.08; margin-bottom: 26px; font-weight: 800; }
  p { margin: 0 0 14px; }
  p:last-child { margin-bottom: 0; }
  .text { font-size: clamp(17px, 2.2vw, 20px); color: var(--body); }

  .card {
    background: linear-gradient(180deg, rgba(255,255,255,0.05), rgba(255,255,255,0.015));
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 22px 20px;
    -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
  }

  .icon {
    flex: none; width: 46px; height: 46px; border-radius: 12px;
    display: grid; place-items: center;
    color: var(--cyan); background: rgba(63, 224, 255, 0.08);
    border: 1px solid rgba(63, 224, 255, 0.25);
  }
  .icon svg { width: 22px; height: 22px; }
  svg.i { fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }

  /* "Next" control */
  .next {
    display: inline-flex; align-items: center; gap: 10px;
    margin-top: 34px; padding: 12px 20px;
    font: 600 13px/1 var(--mono); letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--cyan); text-decoration: none;
    border: 1px solid rgba(63, 224, 255, 0.4); border-radius: 999px;
    transition: background 0.25s, box-shadow 0.25s;
  }
  .next:hover { background: rgba(63, 224, 255, 0.08); box-shadow: 0 0 26px rgba(63, 224, 255, 0.25); }
  .next svg { width: 16px; height: 16px; animation: nudge 1.8s var(--ease) infinite; }

  /* ---------- Hero ---------- */
  .hero { overflow: hidden; }
  .hero .wrap { max-width: 1000px; }
  .orb {
    position: absolute; border-radius: 50%; filter: blur(80px); pointer-events: none; opacity: 0.45;
  }
  .orb.a { width: 420px; height: 420px; background: var(--blue); top: -140px; left: -120px; }
  .orb.b { width: 360px; height: 360px; background: var(--violet); bottom: -160px; right: -100px; opacity: 0.3; }

  .brand {
    display: flex; flex-wrap: wrap; align-items: center; gap: 14px 18px; margin-bottom: 26px;
  }
  .brand-logo {
    display: inline-flex; align-items: center; padding: 10px 16px;
    background: #fff; border-radius: 12px;
    box-shadow: 0 0 0 1px rgba(255,255,255,0.2), 0 10px 40px rgba(0, 0, 0, 0.45);
  }
  .brand-logo img { display: block; height: 34px; width: auto; }
  .brand-name { font: 600 13px/1.5 var(--mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .brand-name b { display: block; color: var(--ink); font-weight: 700; }
  @media (min-width: 700px) { .brand-logo img { height: 42px; } }

  .notice {
    display: flex; gap: 14px; align-items: flex-start;
    max-width: 56ch; margin: 0; padding: 14px 16px;
    font-size: clamp(16px, 2.1vw, 18px); line-height: 1.5; color: var(--body);
    background: var(--green-bg); border: 1px solid var(--green-line); border-radius: 14px;
  }
  .notice svg { flex: none; width: 24px; height: 24px; margin-top: 2px; color: var(--green); }
  .notice strong { color: var(--green); }

  .tag {
    display: inline-flex; align-items: center; gap: 9px;
    font: 700 12px/1 var(--mono); letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--red); background: var(--red-bg);
    border: 1px solid var(--red-line); padding: 9px 14px; border-radius: 999px;
  }
  .tag::before {
    content: ""; width: 8px; height: 8px; border-radius: 50%;
    background: var(--red); box-shadow: 0 0 10px var(--red);
    animation: blink 1.4s steps(2, start) infinite;
  }
  h1 {
    font-size: clamp(40px, 8.4vw, 80px); line-height: 1.02; font-weight: 800;
    margin: 24px 0 24px; letter-spacing: -0.04em;
  }
  h1 .l2 {
    display: block; margin-top: 0.12em;
    background: linear-gradient(92deg, var(--cyan), var(--blue) 55%, var(--violet));
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .lead { font-size: clamp(18px, 2.4vw, 22px); color: var(--muted); max-width: 42ch; margin: 0; }
  .glitch { position: relative; color: var(--ink); animation: glitch 4s infinite; }
  .glitch-title { animation: glitch-title 2.2s infinite; }

  .cue {
    position: absolute; left: 50%; bottom: 22px; transform: translateX(-50%); z-index: 2;
    display: flex; flex-direction: column; align-items: center; gap: 6px;
    font: 600 11px/1 var(--mono); letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--muted); text-decoration: none;
  }
  .cue svg { width: 18px; height: 18px; animation: nudge 1.8s var(--ease) infinite; }

  /* ---------- 01 Safe ---------- */
  .safe-card {
    display: flex; gap: 20px; align-items: flex-start;
    padding: 28px 24px;
    border-color: var(--green-line);
    background: radial-gradient(120% 140% at 0% 0%, rgba(61,220,151,0.16), transparent 60%), var(--green-bg);
    box-shadow: 0 0 60px rgba(61, 220, 151, 0.08);
  }
  .safe-card .icon { color: var(--green); background: rgba(61,220,151,0.12); border-color: var(--green-line); width: 58px; height: 58px; border-radius: 16px; }
  .safe-card .icon svg { width: 28px; height: 28px; }
  .safe-card p { font-size: clamp(18px, 2.4vw, 22px); line-height: 1.55; color: var(--body); }
  .safe-card strong { color: var(--green); }
  @media (max-width: 520px) { .safe-card { flex-direction: column; } }

  /* ---------- 02 How ---------- */
  .how { display: grid; gap: 16px; }
  .how .card { display: flex; gap: 18px; align-items: flex-start; }

  /* ---------- 03 Red flags ---------- */
  .flags { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  @media (min-width: 700px) {
    .flags { grid-template-columns: 1fr 1fr; }
    .flags li:last-child { grid-column: 1 / -1; }
  }
  .flags li {
    display: flex; gap: 16px; align-items: flex-start;
    transition: border-color 0.3s, transform 0.3s var(--ease), box-shadow 0.3s;
  }
  .flags li:hover { border-color: var(--red-line); transform: translateY(-2px); box-shadow: 0 10px 40px rgba(255, 77, 94, 0.08); }
  .flags .icon { color: var(--red); background: var(--red-bg); border-color: var(--red-line); }
  .flags strong { display: block; margin-bottom: 4px; font-size: 18px; }
  .flags span { color: var(--body); font-size: 16px; }

  /* ---------- 04 Before you scan ---------- */
  .checks { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .checks li { display: flex; gap: 16px; align-items: center; font-size: clamp(17px, 2.2vw, 19px); color: var(--body); }
  .checks .icon { width: 40px; height: 40px; border-radius: 50%; }
  .checks .icon svg { width: 18px; height: 18px; stroke-width: 2.4; }

  /* ---------- 05 Urgent ---------- */
  .urgent::before {
    content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: radial-gradient(70% 50% at 50% 40%, rgba(255, 77, 94, 0.12), transparent 70%);
  }
  .urgent h2 { color: var(--ink); }
  .alert {
    border-left: 4px solid var(--red); padding: 16px 18px; margin-bottom: 30px;
    background: var(--red-bg); border-radius: 0 12px 12px 0;
    font-size: clamp(17px, 2.2vw, 20px); color: var(--body);
  }
  .steps { list-style: none; margin: 0; padding: 0; counter-reset: step; }
  .steps li {
    position: relative; counter-increment: step;
    padding: 0 0 26px 64px; color: var(--body); font-size: clamp(16px, 2.1vw, 18px);
  }
  .steps li::before {
    content: counter(step, decimal-leading-zero);
    position: absolute; left: 0; top: -6px;
    width: 44px; height: 44px; border-radius: 12px; display: grid; place-items: center;
    font: 700 14px/1 var(--mono); color: var(--red);
    background: var(--red-bg); border: 1px solid var(--red-line);
  }
  .steps li::after {
    content: ""; position: absolute; left: 22px; top: 44px; bottom: 0; width: 1px;
    background: linear-gradient(var(--red-line), transparent);
  }
  .steps li:last-child { padding-bottom: 0; }
  .steps li:last-child::after { display: none; }
  .steps strong { display: block; margin-bottom: 2px; font-size: 1.08em; }

  /* ---------- 06 Report ---------- */
  .report { text-align: center; padding: 34px 22px; border-color: rgba(63, 224, 255, 0.3); box-shadow: 0 0 80px rgba(63, 224, 255, 0.07); }
  .report .text { max-width: 52ch; margin-left: auto; margin-right: auto; }
  .email {
    display: block; margin: 22px 0;
    font: 700 clamp(12px, 3.4vw, 24px)/1.35 var(--mono); overflow-wrap: anywhere;
    background: linear-gradient(92deg, var(--cyan), var(--blue));
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .btn {
    display: flex; align-items: center; justify-content: center; gap: 12px;
    margin-top: 26px; padding: 18px 20px; border-radius: 14px;
    font-weight: 800; font-size: 18px; text-decoration: none;
    color: #04121a; background: linear-gradient(92deg, var(--cyan), #7fb0ff);
    box-shadow: 0 0 0 1px rgba(63,224,255,0.5), 0 10px 40px rgba(63, 224, 255, 0.3);
    transition: transform 0.2s var(--ease), box-shadow 0.2s;
  }
  .btn:hover { transform: translateY(-2px); box-shadow: 0 0 0 1px rgba(63,224,255,0.7), 0 16px 50px rgba(63, 224, 255, 0.45); }
  .btn svg { width: 22px; height: 22px; stroke-width: 2.2; }

  footer {
    position: relative; z-index: 1; padding: 0 16px 48px;
    text-align: center; color: var(--muted); font: 500 13px/1.6 var(--mono); letter-spacing: 0.08em;
  }

  /* ---------- Scroll reveal (only when JS is running) ---------- */
  .js .reveal { opacity: 0; transform: translateY(26px); transition: opacity 0.8s var(--ease), transform 0.8s var(--ease); }
  .js .reveal.in { opacity: 1; transform: none; }

  /* ---------- Animations ---------- */
  @keyframes blink { to { visibility: hidden; } }
  @keyframes nudge { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(4px); } }
  @keyframes glitch {
    0%, 92%, 100% { text-shadow: none; }
    93% { text-shadow: 2px 0 var(--red), -2px 0 var(--cyan); }
    95% { text-shadow: -2px 0 var(--red), 2px 0 var(--cyan); }
    97% { text-shadow: 1px 0 var(--red), -1px 0 var(--cyan); }
  }

  /* Title glitch: two short bursts per 2.2s cycle, offsets scaled for large type */
  @keyframes glitch-title {
    0%, 38%, 46%, 82%, 92%, 100% { text-shadow: none; }
    40% { text-shadow: 4px 0 var(--red), -4px 0 var(--cyan); }
    42% { text-shadow: -3px 0 var(--red), 3px 0 var(--cyan); }
    44% { text-shadow: 2px 1px var(--red), -2px -1px var(--cyan); }
    84% { text-shadow: -4px 0 var(--red), 4px 0 var(--cyan); }
    87% { text-shadow: 3px -1px var(--red), -3px 1px var(--cyan); }
    90% { text-shadow: -1px 0 var(--red), 1px 0 var(--cyan); }
  }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { animation: none !important; transition: none !important; }
    .js .reveal { opacity: 1; transform: none; }
  }
</style>
